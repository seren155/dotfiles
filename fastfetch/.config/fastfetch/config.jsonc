{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty",
        "source": "~/Pictures/Fetch/fetch.jpg",
        "width": 32,
        "preserveAspectRatio": true,
        "padding": { "top": 1, "left": 1, "right": 2 }
    },

    "display": {
        "separator": " ─ ",
        "size": { "binaryPrefix": "iec" },
        "key": { "width": 12 },
        "color": {
            "keys": "38;5;214",
            "title": "38;5;214"
        }
    },

    "modules": [
        // ── Identity ───────────────────────────────────────────
        {
            "type": "title",
            "format": "{6}{7}{8}",
            "color": { "user": "38;5;214", "at": "38;5;238", "host": "38;5;214" }
        },
        { "type": "separator", "string": "─", "color": { "separator": "38;5;238" } },

        // ── System ─────────────────────────────────────────────
        { "type": "os",       "key": " OS",       "keyColor": "38;5;214" },
        { "type": "kernel",   "key": " Kernel",   "keyColor": "38;5;214" },
        { "type": "uptime",   "key": "󱑃 Uptime",   "keyColor": "38;5;136" },
        { "type": "packages", "key": "󰏖 Packages", "keyColor": "38;5;172" },

        // ── Desktop ────────────────────────────────────────────
        { "type": "shell",    "key": " Shell",    "keyColor": "38;5;108" },
        { "type": "terminal", "key": " Terminal", "keyColor": "38;5;108" },
        { "type": "wm",       "key": " WM",       "keyColor": "38;5;214" },
        { "type": "display",  "key": " Display",  "keyColor": "38;5;66" },

        { "type": "separator", "string": "─", "color": { "separator": "38;5;238" } },

        // ── Performance / gaming ───────────────────────────────
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "38;5;66",
            "temp": true,
            "freqNdigits": 1
        },
        {
            "type": "gpu",
            "key": "󰍛 GPU",
            "keyColor": "38;5;172",
            "temp": true
        },
        { "type": "vulkan",       "key": "󰢮 Vulkan",  "keyColor": "38;5;172" },
        { "type": "powerprofile", "key": "󰓅 Profile", "keyColor": "38;5;136" },

        // ── Memory (the metrics that matter for the RAM goal) ──
        { "type": "memory",    "key": "󰾆 RAM",   "keyColor": "38;5;132" },
        { "type": "swap",      "key": "󰓡 Swap",  "keyColor": "38;5;132" },
        { "type": "processes", "key": "󰍹 Procs", "keyColor": "38;5;132" },

        // ── Storage ────────────────────────────────────────────
        {
            "type": "disk",
            "key": "󰋊 Disk",
            "keyColor": "38;5;172",
            "folders": "/"
        },

        { "type": "separator", "string": "─", "color": { "separator": "38;5;238" } },

        {
            "type": "colors",
            "paddingLeft": 0,
            "symbol": "block",
            "block": { "width": 3, "range": [0, 7] }
        }
    ]
}
